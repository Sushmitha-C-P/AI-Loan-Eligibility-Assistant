# Copy this file to .env.local and fill in ONE provider.
# You can also skip this file and paste the key in the app (AI settings button, top right).

# gemini | groq | openai | openrouter | custom
VITE_AI_PROVIDER=gemini

# Google AI Studio key (free): https://aistudio.google.com/apikey
# Groq key (free):             https://console.groq.com/keys
VITE_AI_API_KEY=

# Leave blank to use the provider default. Use "Load models" in AI settings to see what your key can use.
VITE_AI_MODEL=

# Only for openai / openrouter / custom (OpenAI-compatible) providers
VITE_AI_BASE_URL=
